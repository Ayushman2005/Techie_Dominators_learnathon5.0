# HostelGrievance — Environment Configuration Example
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.

# API server port
HOSTEL_API_PORT=3001

# SQLite database file path (relative to project root)
HOSTEL_DB_PATH=data/hostel.db

# Directory where uploaded attachments are stored (relative to project root)
# In production: use an absolute path OUTSIDE the web-served document root
HOSTEL_UPLOADS_DIR=uploads

# NODE_ENV controls Secure cookie flag and other production behaviors.
# Set to "production" in all non-development environments.
NODE_ENV=development

# Comma-separated list of allowed CORS origins.
# In development this defaults to http://localhost:5173 (no config needed).
# In production, set this to your actual frontend URL(s).
# Example: HOSTEL_ALLOWED_ORIGINS=https://hostelgrievance.youruni.edu
HOSTEL_ALLOWED_ORIGINS=http://localhost:5173
